{
  "Pagenary inline LaTeX": {
    "prefix": "pagenary-inline-latex",
    "body": [
      "\\(${1:x = y}\\)"
    ],
    "description": "Insert Pagenary inline LaTeX using the unambiguous \\(…\\) delimiters."
  },
  "Pagenary display LaTeX": {
    "prefix": "pagenary-display-latex",
    "body": [
      "\\[",
      "${1:\\begin{aligned}}",
      "  ${2:x &= y}",
      "${3:\\end{aligned}}",
      "\\]"
    ],
    "description": "Insert a Pagenary display-LaTeX block."
  },
  "Pagenary LaTeX page": {
    "prefix": "pagenary-latex-page",
    "body": [
      "\\documentclass{article}",
      "\\begin{document}",
      "${1}",
      "\\end{document}"
    ],
    "description": "Create the minimal structure for a Pagenary .tex page."
  },
  "Pagenary Mermaid diagram": {
    "prefix": "pagenary-mermaid",
    "body": [
      "```mermaid title=\"${1:Diagram title}\"",
      "flowchart LR",
      "  ${2:A} --> ${3:B}",
      "```"
    ],
    "description": "Insert a titled Mermaid fence using the local renderer contract."
  },
  "Pagenary PlantUML diagram": {
    "prefix": "pagenary-plantuml",
    "body": [
      "```plantuml title=\"${1:Diagram title}\"",
      "@startuml",
      "${2:Author} -> ${3:Pagenary}: ${4:Build}",
      "@enduml",
      "```"
    ],
    "description": "Insert a titled PlantUML fence for bounded local rendering."
  }
}
