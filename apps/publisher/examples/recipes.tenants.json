{
  "$comment": "Theming recipe gallery (issue #31). Every nav/style/color recipe reuses the shared docs in examples/content-base and differs only by its inline `config`. The interocitor showcase uses its own richer content. Build with: npm run build:examples",
  "tenants": [
    {
      "id": "theme-colors",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Aurora",
        "brandSub": "Docs",
        "accentColor": "#7c3aed",
        "surfaceColor": "#faf5ff",
        "inkColor": "#2e1065",
        "mutedColor": "#6d5b9c",
        "gridLineColor": "rgba(124, 58, 237, 0.16)"
      }
    },
    {
      "id": "theme-dark",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Nocturne",
        "brandSub": "Docs",
        "theme": "dark"
      }
    },
    {
      "id": "theme-matrix",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Oracle",
        "brandSub": "Terminal",
        "theme": "matrix"
      }
    },
    {
      "id": "basic-styles",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Foundry",
        "brandSub": "Press",
        "accentColor": "#b45309",
        "fontBody": "Georgia, 'Times New Roman', serif",
        "fontMono": "'Courier New', Courier, monospace"
      }
    },
    {
      "id": "nav-left",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Layout",
        "brandSub": "Left",
        "navPosition": "left"
      }
    },
    {
      "id": "nav-right",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Layout",
        "brandSub": "Right",
        "navPosition": "right"
      }
    },
    {
      "id": "nav-top",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Layout",
        "brandSub": "Top",
        "navPosition": "top"
      }
    },
    {
      "id": "nav-bottom",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Layout",
        "brandSub": "Bottom",
        "navPosition": "bottom"
      }
    },
    {
      "id": "nav-hybrid",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Layout",
        "brandSub": "Hybrid",
        "accentColor": "#2563eb",
        "navPosition": "hybrid"
      }
    },
    {
      "id": "theme-picker",
      "source": { "type": "local", "path": "./examples/content-base" },
      "config": {
        "brandMark": "Switchable",
        "brandSub": "Docs",
        "themePicker": {
          "enabled": true,
          "themes": ["light", "dark", "matrix"],
          "default": "light"
        }
      }
    },
    {
      "id": "docs-map",
      "source": { "type": "local", "path": "./examples/docs-map-corpus" },
      "config": {
        "docsMap": { "enabled": true }
      }
    },
    {
      "id": "interocitor",
      "source": { "type": "local", "path": "./examples/interocitor" }
    },
    {
      "id": "blog-demo",
      "source": { "type": "local", "path": "./examples/blog-demo" }
    },
    {
      "id": "page-effects",
      "source": { "type": "local", "path": "./examples/page-effects" }
    },
    {
      "$comment": "Blog theme gallery — every variant reuses examples/blog-demo's posts and differs only by its inline theme config (the same content-base pattern the docs recipes use). Same blog layout, many looks.",
      "id": "blog-dark",
      "source": { "type": "local", "path": "./examples/blog-demo" },
      "config": {
        "title": "Umbra — a dark blog",
        "brandMark": "Umbra",
        "brandSub": "Journal",
        "theme": "dark",
        "accentColor": "#a78bfa"
      }
    },
    {
      "id": "blog-editorial",
      "source": { "type": "local", "path": "./examples/blog-demo" },
      "config": {
        "title": "The Quill — an editorial blog",
        "brandMark": "The Quill",
        "brandSub": "Review",
        "accentColor": "#9a3412",
        "surfaceColor": "#fbf7f0",
        "inkColor": "#2b2118",
        "mutedColor": "#7c6f5f",
        "gridLineColor": "rgba(43, 33, 24, 0.12)",
        "fontBody": "Georgia, 'Iowan Old Style', 'Times New Roman', serif"
      }
    },
    {
      "id": "blog-rail",
      "source": { "type": "local", "path": "./examples/blog-demo" },
      "config": {
        "title": "Dispatch — a blog with a posts rail",
        "brandMark": "Dispatch",
        "brandSub": "Notes",
        "accentColor": "#2563eb",
        "blog": { "sidebar": "rail", "indexTitle": "Latest posts" }
      }
    },
    {
      "id": "blog-vivid",
      "source": { "type": "local", "path": "./examples/blog-demo" },
      "config": {
        "title": "Prism — a vivid blog",
        "brandMark": "Prism",
        "brandSub": "Blog",
        "accentColor": "#db2777",
        "surfaceColor": "#fff7fb",
        "inkColor": "#3b0a2a",
        "mutedColor": "#9d4e7c",
        "gridLineColor": "rgba(219, 39, 119, 0.16)"
      }
    },
    {
      "id": "blog-matrix",
      "source": { "type": "local", "path": "./examples/blog-demo" },
      "config": {
        "title": "Terminal — a matrix blog",
        "brandMark": "Terminal",
        "brandSub": "Log",
        "theme": "matrix"
      }
    }
  ]
}
