{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "features"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "example", "anchor", "help"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "example": { "type": "string" },
          "anchor": { "type": "string" },
          "help": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
