{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pagenary.io/schemas/tenants.schema.json",
  "title": "Pagenary Tenant Registry",
  "description": "Configuration file for multi-tenant documentation builds",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for validation"
    },
    "tenants": {
      "type": "array",
      "description": "List of tenant configurations",
      "items": {
        "$ref": "#/definitions/tenant"
      }
    },
    "defaults": {
      "$ref": "#/definitions/defaults",
      "description": "Default source and target paths for tenants without explicit paths"
    }
  },
  "required": ["tenants"],
  "definitions": {
    "tenant": {
      "type": "object",
      "description": "A single tenant configuration",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
          "description": "Unique tenant identifier (lowercase alphanumeric with hyphens)"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this tenant should be built"
        },
        "accountId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
          "description": "Managed-hosting account/group id used for plan site-limit enforcement."
        },
        "source": {
          "$ref": "#/definitions/sourcePath",
          "description": "Where to read tenant content from"
        },
        "target": {
          "$ref": "#/definitions/targetPath",
          "description": "Where to write built tenant bundle"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Domain names for routing (used by Caddyfile generator)"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "team"],
          "default": "free",
          "description": "Managed-hosting plan gate. Used by scripts/managed-hosting.js."
        },
        "subdomain": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
          "description": "Managed-hosting subdomain label for <subdomain>.pagenary.app. Defaults to tenant id."
        },
        "siteCount": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of hosted sites consumed by this tenant/account for plan gating."
        },
        "privateRepo": {
          "type": "boolean",
          "default": false,
          "description": "Whether the connected source repo is private. Requires Pro or Team in managed hosting."
        },
        "repoCredentialRef": {
          "type": "string",
          "description": "Reference name for the private control-plane deploy key or OAuth credential."
        },
        "webhookSecretRef": {
          "type": "string",
          "description": "Reference name for the private control-plane webhook secret."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["free", "manual-pending", "active", "past-due", "canceled"],
          "default": "manual-pending",
          "description": "Concierge billing state mirrored from Stripe or manual onboarding."
        },
        "verifiedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Custom domains verified by the private hosting control plane."
        },
        "suspendedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Custom domains disabled by downgrade/cancel events and retained for recovery."
        },
        "whiteLabel": {
          "type": "boolean",
          "default": false,
          "description": "White-label entitlement request. Requires Team in managed hosting."
        },
        "sso": {
          "type": "boolean",
          "default": false,
          "description": "SSO entitlement request. Requires Team in managed hosting."
        },
        "config": {
          "$ref": "#/definitions/tenantConfig",
          "description": "Branding and configuration overrides"
        }
      }
    },
    "sourcePath": {
      "oneOf": [
        { "$ref": "#/definitions/localSource" },
        { "$ref": "#/definitions/gitSource" }
      ],
      "description": "Source location for tenant content (local path or git repository)"
    },
    "localSource": {
      "type": "object",
      "description": "Local filesystem source",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["local"],
          "default": "local",
          "description": "Local source type"
        },
        "path": {
          "type": "string",
          "description": "Path to tenant source directory. Relative paths resolve from publisher root. Supports environment variable expansion ($VAR or ${VAR})."
        }
      },
      "required": ["path"]
    },
    "gitSource": {
      "type": "object",
      "description": "Git repository source",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["git"],
          "description": "Git source type"
        },
        "url": {
          "type": "string",
          "description": "Git repository URL (HTTPS, SSH, or file://)"
        },
        "ref": {
          "type": "string",
          "default": "main",
          "description": "Branch, tag, or commit SHA to checkout"
        },
        "path": {
          "type": "string",
          "default": ".",
          "description": "Subdirectory within repository containing tenant content"
        },
        "sparse": {
          "type": "boolean",
          "default": false,
          "description": "Use sparse checkout (only fetch subdirectory specified by path)"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Shallow clone depth (1 = latest commit only)"
        }
      },
      "required": ["type", "url"]
    },
    "targetPath": {
      "type": "object",
      "description": "Target location for built tenant bundle",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["local"],
          "default": "local",
          "description": "Target type (currently only 'local' is supported)"
        },
        "path": {
          "type": "string",
          "description": "Path to output directory. Relative paths resolve from publisher root. Supports environment variable expansion ($VAR or ${VAR})."
        }
      }
    },
    "tenantConfig": {
      "type": "object",
      "description": "Tenant branding and configuration",
      "properties": {
        "title": {
          "type": "string",
          "description": "HTML page title"
        },
        "description": {
          "type": "string",
          "description": "Meta description for SEO"
        },
        "brandMark": {
          "type": "string",
          "description": "Primary brand text in header"
        },
        "brandSub": {
          "type": "string",
          "description": "Secondary brand text in header"
        },
        "tagline": {
          "type": "string",
          "description": "Tagline shown in header"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "CSS accent color (hex format)"
        },
        "surfaceColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Page surface color (hex format)"
        },
        "inkColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Primary text color (hex format)"
        },
        "mutedColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Muted text color (hex format)"
        },
        "gridLineColor": {
          "type": "string",
          "description": "CSS color for borders and dividers"
        },
        "theme": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["light", "dark", "matrix"]
            },
            {
              "$ref": "#/definitions/themeConfig"
            }
          ],
          "description": "Theme preset or custom theme object"
        },
        "themePicker": {
          "$ref": "#/definitions/themePickerConfig",
          "description": "Optional runtime theme picker"
        },
        "fontBody": {
          "type": "string",
          "description": "CSS font stack for prose"
        },
        "fontMono": {
          "type": "string",
          "description": "CSS font stack for code and monospace UI"
        },
        "navPosition": {
          "type": "string",
          "enum": ["left", "right", "top", "bottom", "hybrid"],
          "default": "left",
          "description": "Navigation placement"
        },
        "navAlign": {
          "type": "string",
          "enum": ["top", "spread", "bottom", "left", "right"],
          "default": "top",
          "description": "Sidebar list alignment. Vertical: top (default), spread (distribute across the column), bottom. Horizontal: left (default edge), right."
        },
        "layout": {
          "type": "string",
          "enum": ["docs", "blog"],
          "default": "docs",
          "description": "Layout family: docs (sidebar shell) or blog (chronological index + hero post pages)."
        },
        "blog": {
          "type": "object",
          "description": "Blog layout options (used when layout is \"blog\").",
          "properties": {
            "sidebar": {
              "type": "string",
              "enum": ["hidden", "rail"],
              "default": "hidden",
              "description": "hidden (single reading column) or rail (content + a posts/tags rail)."
            },
            "indexTitle": { "type": "string", "description": "Heading shown above the post index." },
            "collection": { "type": "string", "description": "path of the collection the index renders, when several are declared (default: first)." }
          }
        },
        "collections": {
          "type": "array",
          "description": "Folders scanned as dated post collections; each emits index.json (+ optional RSS feed.xml).",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "description": "Folder (relative to the content root) to scan for posts." },
              "route": { "type": "string", "description": "Output route under dist (default: /<path>)." },
              "title": { "type": "string" },
              "manifest": { "type": "boolean", "default": true, "description": "Emit index.json." },
              "feed": { "type": "boolean", "default": false, "description": "Emit RSS feed.xml." },
              "sortBy": { "type": "string", "default": "date" },
              "order": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
              "showDate": { "type": "boolean", "default": false },
              "showSummary": { "type": "boolean", "default": false },
              "showReadingTime": { "type": "boolean", "default": true }
            }
          }
        },
        "cacheStrategy": {
          "type": "string",
          "enum": ["contentHash", "stable"],
          "default": "contentHash",
          "description": "Runtime filename strategy. contentHash is the default for CDN-safe immutable assets; stable keeps legacy filenames."
        },
        "welcome": {
          "$ref": "#/definitions/welcomeConfig",
          "description": "Welcome section customization"
        },
        "docsMap": {
          "$ref": "#/definitions/docsMapConfig",
          "description": "Optional documentation relationship map"
        }
      }
    },
    "themeConfig": {
      "type": "object",
      "description": "Custom theme tokens. Unknown keys are allowed so advanced build-time overrides can remain forward-compatible.",
      "properties": {
        "colorScheme": {
          "type": "string",
          "enum": ["light", "dark"],
          "description": "Browser color-scheme hint"
        },
        "surface": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Page surface color"
        },
        "ink": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Primary text color"
        },
        "muted": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Muted text color"
        },
        "accent": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Accent color"
        },
        "gridLine": {
          "type": "string",
          "description": "CSS color for borders and dividers"
        },
        "highlightBg": {
          "type": "string",
          "description": "Search highlight background"
        },
        "highlightBorder": {
          "type": "string",
          "description": "Search highlight border"
        },
        "fontBody": {
          "type": "string",
          "description": "CSS font stack for prose"
        },
        "fontMono": {
          "type": "string",
          "description": "CSS font stack for code and monospace UI"
        }
      },
      "additionalProperties": true
    },
    "themePickerConfig": {
      "type": "object",
      "description": "Runtime theme picker configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Add the picker control"
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["light", "dark", "matrix", "custom"]
          },
          "default": ["light", "dark", "matrix"],
          "description": "Selectable theme stylesheets to emit"
        },
        "default": {
          "type": "string",
          "description": "Initial theme name"
        }
      },
      "additionalProperties": false
    },
    "docsMapConfig": {
      "type": "object",
      "description": "Docs Map relationship view configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Add the Docs Map page and navigation entry"
        },
        "title": {
          "type": "string",
          "default": "Docs Map",
          "description": "Docs Map page title"
        },
        "renderer": {
          "type": "string",
          "enum": ["svg", "cytoscape"],
          "default": "svg",
          "description": "Graph renderer. svg is the default and fallback; cytoscape is reserved for the richer optional renderer."
        }
      }
    },
    "welcomeConfig": {
      "type": "object",
      "description": "Welcome section content",
      "properties": {
        "eyebrow": {
          "type": "string",
          "description": "Small text above headline"
        },
        "headline": {
          "type": "string",
          "description": "Main welcome heading"
        },
        "lead": {
          "type": "string",
          "description": "Introductory paragraph"
        },
        "pillars": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Value proposition bullet points"
        },
        "checklist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Getting started checklist items"
        },
        "quickLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "href": { "type": "string" }
            },
            "required": ["label", "href"]
          },
          "description": "Quick navigation links"
        },
        "quote": {
          "type": "string",
          "description": "Optional quote or testimonial"
        }
      }
    },
    "defaults": {
      "type": "object",
      "description": "Default paths for tenants without explicit configuration",
      "properties": {
        "source": {
          "$ref": "#/definitions/sourcePath"
        },
        "target": {
          "$ref": "#/definitions/targetPath"
        }
      }
    }
  }
}
