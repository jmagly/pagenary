{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pagenary.io/schemas/tenants.schema.json",
  "title": "Pagenary Tenant Registry",
  "description": "Configuration file for multi-tenant documentation builds",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for validation"
    },
    "tenants": {
      "type": "array",
      "description": "List of tenant configurations",
      "items": {
        "$ref": "#/definitions/tenant"
      }
    },
    "defaults": {
      "$ref": "#/definitions/defaults",
      "description": "Default source and target paths for tenants without explicit paths"
    }
  },
  "required": ["tenants"],
  "definitions": {
    "tenant": {
      "type": "object",
      "description": "A single tenant configuration",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
          "description": "Unique tenant identifier (lowercase alphanumeric with hyphens)"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this tenant should be built"
        },
        "source": {
          "$ref": "#/definitions/sourcePath",
          "description": "Where to read tenant content from"
        },
        "target": {
          "$ref": "#/definitions/targetPath",
          "description": "Where to write built tenant bundle"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Domain names for routing (used by Caddyfile generator)"
        },
        "basePath": {
          "type": "string",
          "pattern": "^/?[^\\s?#]*$",
          "description": "Optional deploy mount path for the generated <base href>, such as /react/. Use when the public subpath differs from the tenant id."
        },
        "config": {
          "$ref": "#/definitions/tenantConfig",
          "description": "Branding and configuration overrides"
        }
      }
    },
    "sourcePath": {
      "oneOf": [
        { "$ref": "#/definitions/localSource" },
        { "$ref": "#/definitions/gitSource" }
      ],
      "description": "Source location for tenant content (local path or git repository)"
    },
    "localSource": {
      "type": "object",
      "description": "Local filesystem source",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["local"],
          "default": "local",
          "description": "Local source type"
        },
        "path": {
          "type": "string",
          "description": "Path to tenant source directory. Relative paths resolve from publisher root. Supports environment variable expansion ($VAR or ${VAR})."
        }
      },
      "required": ["path"]
    },
    "gitSource": {
      "type": "object",
      "description": "Git repository source",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["git"],
          "description": "Git source type"
        },
        "url": {
          "type": "string",
          "description": "Git repository URL (HTTPS, SSH, or file://)"
        },
        "ref": {
          "type": "string",
          "default": "main",
          "description": "Branch, tag, or commit SHA to checkout"
        },
        "path": {
          "type": "string",
          "default": ".",
          "description": "Subdirectory within repository containing tenant content"
        },
        "sparse": {
          "type": "boolean",
          "default": false,
          "description": "Use sparse checkout (only fetch subdirectory specified by path)"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Shallow clone depth (1 = latest commit only)"
        }
      },
      "required": ["type", "url"]
    },
    "targetPath": {
      "type": "object",
      "description": "Target location for built tenant bundle",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["local"],
          "default": "local",
          "description": "Target type (currently only 'local' is supported)"
        },
        "path": {
          "type": "string",
          "description": "Path to output directory. Relative paths resolve from publisher root. Supports environment variable expansion ($VAR or ${VAR})."
        }
      }
    },
    "tenantConfig": {
      "type": "object",
      "description": "Tenant branding and configuration",
      "properties": {
        "title": {
          "type": "string",
          "description": "HTML page title"
        },
        "description": {
          "type": "string",
          "description": "Meta description for SEO"
        },
        "brandMark": {
          "type": "string",
          "description": "Primary brand text in header"
        },
        "brandSub": {
          "type": "string",
          "description": "Secondary brand text in header"
        },
        "tagline": {
          "type": "string",
          "description": "Tagline shown in header"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "CSS accent color (hex format)"
        },
        "surfaceColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Page surface color (hex format)"
        },
        "inkColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Primary text color (hex format)"
        },
        "mutedColor": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Muted text color (hex format)"
        },
        "gridLineColor": {
          "type": "string",
          "description": "CSS color for borders and dividers"
        },
        "theme": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["light", "dark", "matrix"]
            },
            {
              "$ref": "#/definitions/themeConfig"
            }
          ],
          "description": "Theme preset or custom theme object"
        },
        "themePicker": {
          "$ref": "#/definitions/themePickerConfig",
          "description": "Optional runtime theme picker"
        },
        "fontBody": {
          "type": "string",
          "description": "CSS font stack for prose"
        },
        "fontMono": {
          "type": "string",
          "description": "CSS font stack for code and monospace UI"
        },
        "navPosition": {
          "type": "string",
          "enum": ["left", "right", "top", "bottom", "hybrid"],
          "default": "left",
          "description": "Navigation placement"
        },
        "navAlign": {
          "type": "string",
          "enum": ["top", "spread", "bottom", "left", "right"],
          "default": "top",
          "description": "Sidebar list alignment. Vertical: top (default), spread (distribute across the column), bottom. Horizontal: left (default edge), right."
        },
        "layout": {
          "type": "string",
          "enum": ["docs", "blog"],
          "default": "docs",
          "description": "Layout family: docs (sidebar shell) or blog (chronological index + hero post pages)."
        },
        "blog": {
          "type": "object",
          "description": "Blog layout options (used when layout is \"blog\").",
          "properties": {
            "sidebar": {
              "type": "string",
              "enum": ["hidden", "rail"],
              "default": "hidden",
              "description": "hidden (single reading column) or rail (content + a posts/tags rail)."
            },
            "indexTitle": { "type": "string", "description": "Heading shown above the post index." },
            "collection": { "type": "string", "description": "path of the collection the index renders, when several are declared (default: first)." }
          }
        },
        "collections": {
          "type": "array",
          "description": "Folders scanned as dated post collections; each emits index.json (+ optional RSS feed.xml).",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "description": "Folder (relative to the content root) to scan for posts." },
              "route": { "type": "string", "description": "Output route under dist (default: /<path>)." },
              "title": { "type": "string" },
              "manifest": { "type": "boolean", "default": true, "description": "Emit index.json." },
              "feed": { "type": "boolean", "default": false, "description": "Emit RSS feed.xml." },
              "sortBy": { "type": "string", "default": "date" },
              "order": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
              "showDate": { "type": "boolean", "default": false },
              "showSummary": { "type": "boolean", "default": false },
              "showReadingTime": { "type": "boolean", "default": true }
            }
          }
        },
        "cacheStrategy": {
          "type": "string",
          "enum": ["contentHash", "stable"],
          "default": "contentHash",
          "description": "Runtime filename strategy. contentHash is the default for CDN-safe immutable assets; stable keeps legacy filenames."
        },
        "basePath": {
          "type": "string",
          "pattern": "^/?[^\\s?#]*$",
          "description": "Optional deploy mount path for the generated <base href>, such as /react/. Registry-level basePath overrides this value."
        },
        "runtime": {
          "$ref": "#/definitions/runtimeConfig",
          "description": "Optional publishing runtime. Missing runtime preserves the default static Pagenary shell."
        },
        "seo": {
          "$ref": "#/definitions/seoConfig",
          "description": "SEO, crawl, and search visibility controls"
        },
        "export": {
          "$ref": "#/definitions/exportConfig",
          "description": "Print/PDF export controls"
        },
        "share": {
          "$ref": "#/definitions/shareConfig",
          "description": "Optional page sharing control"
        },
        "welcome": {
          "$ref": "#/definitions/welcomeConfig",
          "description": "Welcome section customization"
        },
        "docsMap": {
          "$ref": "#/definitions/docsMapConfig",
          "description": "Optional documentation relationship map"
        }
      }
    },
    "themeConfig": {
      "type": "object",
      "description": "Custom theme tokens. Unknown keys are allowed so advanced build-time overrides can remain forward-compatible.",
      "properties": {
        "colorScheme": {
          "type": "string",
          "enum": ["light", "dark"],
          "description": "Browser color-scheme hint"
        },
        "surface": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Page surface color"
        },
        "ink": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Primary text color"
        },
        "muted": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Muted text color"
        },
        "accent": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "Accent color"
        },
        "gridLine": {
          "type": "string",
          "description": "CSS color for borders and dividers"
        },
        "highlightBg": {
          "type": "string",
          "description": "Search highlight background"
        },
        "highlightBorder": {
          "type": "string",
          "description": "Search highlight border"
        },
        "fontBody": {
          "type": "string",
          "description": "CSS font stack for prose"
        },
        "fontMono": {
          "type": "string",
          "description": "CSS font stack for code and monospace UI"
        }
      },
      "additionalProperties": true
    },
    "runtimeConfig": {
      "type": "object",
      "description": "Static, hybrid, or React-backed tenant runtime configuration.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["static", "hybrid", "react-spa"],
          "default": "static",
          "description": "static keeps the current vanilla runtime. hybrid adds selected React app routes with authored fallbacks. react-spa is reserved for a full React shell."
        },
        "react": {
          "$ref": "#/definitions/reactRuntimeConfig",
          "description": "React adapter settings used when mode is hybrid or react-spa. Ignored in static mode."
        }
      },
      "additionalProperties": false
    },
    "reactRuntimeConfig": {
      "type": "object",
      "description": "Tenant-local React adapter configuration.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Set true with runtime.mode hybrid or react-spa."
        },
        "adapter": {
          "type": "string",
          "default": "@pagenary/react",
          "description": "Optional adapter package name. Defaults to @pagenary/react."
        },
        "entry": {
          "type": "string",
          "pattern": "^(?!\\.\\.|/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$)).+\\.(jsx|tsx|js|mjs|ts)$",
          "description": "Tenant-local React/Vite entry point, such as app/main.jsx."
        },
        "mount": {
          "type": "string",
          "pattern": "^#[A-Za-z][\\w:.-]*$",
          "description": "CSS id selector that the React entry mounts into."
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "description": "React app routes that also have Pagenary fallbacks for static hosts, crawlers, and no-JS readers.",
          "items": { "$ref": "#/definitions/reactRuntimeRoute" }
        },
        "ssg": {
          "type": "object",
          "properties": {
            "staticFallbacks": {
              "type": "boolean",
              "default": true,
              "description": "Must remain true for the hybrid prototype."
            },
            "snapshotRoutes": {
              "type": "boolean",
              "default": true,
              "description": "Emit Pagenary static snapshots for React route fallbacks."
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["entry", "mount", "routes"],
      "additionalProperties": false
    },
    "reactRuntimeRoute": {
      "type": "object",
      "description": "A React route with an authored Pagenary fallback.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Pagenary section id that represents the route."
        },
        "title": {
          "type": "string",
          "description": "Display title for docs, smoke reports, and UAT docs."
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\s?#]*$",
          "description": "Public path reserved for future React router integration, such as /dashboard."
        },
        "fallback": {
          "type": "string",
          "pattern": "^(?!\\.\\.|/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$)).+\\.(md|markdown|html|htm)$",
          "description": "Tenant-local Markdown or HTML fallback file that Pagenary publishes as a normal static page."
        }
      },
      "required": ["id", "path", "fallback"],
      "additionalProperties": false
    },
    "shareConfig": {
      "type": "object",
      "description": "Optional page sharing controls. Built-in targets use plain outbound URLs only after user action.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Set true to show the Share control"
        },
        "native": {
          "type": "string",
          "enum": ["auto", "always", "never"],
          "default": "auto",
          "description": "Use browser-native Web Share on touch devices when available, always when available, or never"
        },
        "services": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "copy", "email", "x", "linkedin", "facebook", "threads", "bluesky",
                  "reddit", "hackernews", "lobsters", "producthunt", "slashdot",
                  "sms", "whatsapp", "telegram", "signal", "messenger",
                  "mastodon", "misskey", "lemmy", "instapaper",
                  "pinboard", "raindrop", "teams", "notion",
                  "trello", "pinterest", "tumblr"
                ]
              },
              { "$ref": "#/definitions/customShareService" }
            ]
          },
          "default": ["copy", "email"],
          "description": "Desktop fallback menu services. Copy Link and Email are always added as safe baseline targets."
        },
        "mastodon": { "$ref": "#/definitions/federatedShareInstance" },
        "misskey": { "$ref": "#/definitions/federatedShareInstance" },
        "lemmy": { "$ref": "#/definitions/federatedShareInstance" }
      },
      "additionalProperties": false
    },
    "customShareService": {
      "type": "object",
      "description": "Custom tenant-provided share target. Supported template tokens: {url}, {title}, {text}, {description}.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "urlTemplate": {
          "type": "string",
          "pattern": "^(https?:\\/\\/|mailto:|sms:|sgnl:\\/\\/|fb-messenger:\\/\\/).+"
        },
        "icon": {
          "type": "object",
          "description": "Optional local icon paths for custom share services. Remote icon URLs are not accepted.",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^(?!https?:\\/\\/|\\/\\/)[^<>\\r\\n]+$"
            },
            "mono": {
              "type": "string",
              "pattern": "^(?!https?:\\/\\/|\\/\\/)[^<>\\r\\n]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "label", "urlTemplate"],
      "additionalProperties": false
    },
    "federatedShareInstance": {
      "type": "object",
      "description": "Optional configured instance for federated/decentralized share targets",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["default", "configured-instance"],
          "default": "default"
        },
        "instance": {
          "type": "string",
          "description": "Instance host or absolute origin, such as mastodon.social or https://fosstodon.org"
        }
      },
      "additionalProperties": false
    },
    "exportConfig": {
      "type": "object",
      "description": "Print/PDF export controls",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Set false to remove the Export button"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["page", "site"]
          },
          "default": ["page", "site"],
          "description": "Allowed export scopes"
        },
        "logo": {
          "type": "string",
          "enum": ["embed", "reference", "none"],
          "default": "embed",
          "description": "Export header logo mode"
        },
        "logoPath": {
          "type": "string",
          "description": "Path within .public/ to the export header logo"
        },
        "showTagline": {
          "type": "boolean",
          "default": true
        },
        "showDate": {
          "type": "boolean",
          "default": true
        },
        "watermark": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean", "default": true },
                "text": { "type": "string" }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          ],
          "description": "Optional visible export watermark. This is an intent signal, not DRM."
        }
      },
      "additionalProperties": true
    },
    "seoConfig": {
      "type": "object",
      "description": "SEO artifact and crawl visibility configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Set false to skip all SEO artifact generation"
        },
        "siteUrl": {
          "type": "string",
          "description": "Absolute base URL for sitemap, canonical, Open Graph, and robots sitemap URLs"
        },
        "discoverabilityProfile": {
          "type": "string",
          "enum": ["standard", "open", "limited", "locked"],
          "default": "standard",
          "description": "High-level SEO artifact preset: standard public docs, open machine-readable corpus, limited reduced discoverability, or locked advisory static-site lockdown"
        },
        "ogImage": {
          "type": "string",
          "description": "Social share image for Open Graph and Twitter cards"
        },
        "generateSitemap": {
          "type": "boolean",
          "default": true,
          "description": "Emit sitemap.xml"
        },
        "generateStaticPages": {
          "type": "boolean",
          "default": true,
          "description": "Emit per-section static HTML snapshots"
        },
        "rootHtmlFallback": {
          "type": "boolean",
          "default": true,
          "description": "Embed the default page HTML into the root SPA shell so the root URL remains readable without JavaScript"
        },
        "generateRobotsTxt": {
          "type": "boolean",
          "default": true,
          "description": "Emit robots.txt"
        },
        "generateLlmsTxt": {
          "type": "boolean",
          "description": "Emit llms.txt. Defaults are profile-aware."
        },
        "generateCorpusArtifacts": {
          "type": "boolean",
          "description": "Emit content-index.json, documents.jsonl, and per-page machine-readable JSON/text extracts. Defaults on for the open profile only."
        },
        "noIndex": {
          "type": "boolean",
          "default": false,
          "description": "Emit noindex/nofollow metadata and a restrictive robots.txt"
        },
        "defaultChangeFreq": {
          "type": "string",
          "default": "weekly",
          "description": "Default sitemap change frequency for the root entry"
        },
        "robots": {
          "type": "object",
          "description": "robots.txt directives. These are crawler hints, not access control.",
          "properties": {
            "userAgent": {
              "type": "string",
              "default": "*"
            },
            "allow": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Allow directives"
            },
            "disallow": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Disallow directives"
            },
            "sitemap": {
              "type": "boolean",
              "default": true,
              "description": "Include the Sitemap directive in robots.txt"
            },
            "blockAll": {
              "type": "boolean",
              "default": false,
              "description": "Emit Disallow: / for the configured user agent"
            }
          },
          "additionalProperties": false
        },
        "aiCrawlers": {
          "type": "object",
          "description": "Advisory AI crawler/content-signal preferences emitted in robots.txt when configured",
          "properties": {
            "search": {
              "type": "boolean",
              "description": "Signal whether search indexing/fetching is allowed"
            },
            "aiInput": {
              "type": "boolean",
              "description": "Signal whether use as AI answer/input grounding is allowed"
            },
            "aiTrain": {
              "type": "boolean",
              "description": "Signal whether AI training use is allowed"
            }
          },
          "additionalProperties": false
        },
        "structuredData": {
          "type": "object",
          "properties": {
            "organizationName": { "type": "string" },
            "logoUrl": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "themePickerConfig": {
      "type": "object",
      "description": "Runtime theme picker configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Add the picker control"
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["light", "dark", "matrix", "custom"]
          },
          "default": ["light", "dark", "matrix"],
          "description": "Selectable theme stylesheets to emit"
        },
        "default": {
          "type": "string",
          "description": "Initial theme name"
        }
      },
      "additionalProperties": false
    },
    "docsMapConfig": {
      "type": "object",
      "description": "Docs Map relationship view configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Add the Docs Map page and navigation entry"
        },
        "title": {
          "type": "string",
          "default": "Docs Map",
          "description": "Docs Map page title"
        },
        "renderer": {
          "type": "string",
          "enum": ["svg", "cytoscape", "fortemi-react"],
          "default": "svg",
          "description": "Graph renderer. svg is the default and fallback; fortemi-react enables the optional React/Sigma graph control when the React adapter is mounted."
        }
      }
    },
    "welcomeConfig": {
      "type": "object",
      "description": "Welcome section content",
      "properties": {
        "eyebrow": {
          "type": "string",
          "description": "Small text above headline"
        },
        "headline": {
          "type": "string",
          "description": "Main welcome heading"
        },
        "lead": {
          "type": "string",
          "description": "Introductory paragraph"
        },
        "pillars": {
          "type": "array",
