{
  "name": "@pagenary/publisher",
  "version": "2026.7.1",
  "type": "module",
  "description": "Multi-tenant static publishing component for Pagenary platform.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://git.integrolabs.net/roctinam/pagenary",
  "repository": {
    "type": "git",
    "url": "git+https://git.integrolabs.net/roctinam/pagenary.git",
    "directory": "apps/publisher"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pagenary": "bin/pagenary.mjs"
  },
  "files": [
    "src/",
    "scripts/",
    "site/",
    "examples/",
    "build.config.json",
    "tenants.schema.json",
    "tenants.json.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm run build:dev && npm run serve:dev",
    "build": "node bin/pagenary.mjs build",
    "build:dev": "NODE_ENV=development node bin/pagenary.mjs build --dev",
    "build:tenants": "node bin/pagenary.mjs build:tenants",
    "build:tenant": "node bin/pagenary.mjs build:tenant",
    "build:examples": "node scripts/build-tenants.js --registry examples/recipes.tenants.json",
    "build:examples:site": "node scripts/build-tenants.js --registry examples/recipes.tenants.json --target dist/pagenary",
    "build:site": "node scripts/build-tenants.js pagenary && node scripts/build-site.js",
    "prepack": "node scripts/build-tenants.js pagenary >&2 && node scripts/build-site.js >&2",
    "build:incremental": "node scripts/build-tenants.js --incremental",
    "build:diff": "node scripts/build-tenants.js --diff-only",
    "tenants:list": "node bin/pagenary.mjs tenants:list",
    "tenants:diff": "node bin/pagenary.mjs tenants:diff",
    "serve": "node bin/pagenary.mjs serve",
    "serve:dev": "NODE_ENV=development node bin/pagenary.mjs serve --dev",
    "start": "npm run build && npm run serve",
    "clean": "node bin/pagenary.mjs clean",
    "sync:docs": "node bin/pagenary.mjs sync",
    "lint:content": "node bin/pagenary.mjs lint",
    "check:accessibility": "node scripts/check-accessibility.js && node scripts/check-accessibility-linter.js && node scripts/check-accessibility-report.js",
    "check:media": "node scripts/check-media-renderers.js",
    "check:narration": "node scripts/check-narration.js",
    "check:reading": "node scripts/check-reading-metadata.js",
    "check:seo": "node scripts/seo-smoke.js",
    "check": "npm run lint:content && npm run check:accessibility && npm run check:media && npm run check:narration && npm run check:reading && npm run build && npm run check:seo",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch",
    "ci": "npm run check && npm test",
    "caddy:up": "docker compose up -d caddy",
    "caddy:down": "docker compose down",
    "caddy:restart": "docker compose restart caddy",
    "caddy:logs": "docker compose logs -f caddy",
    "caddy:reload": "docker compose exec caddy caddy reload --config /srv/app/Caddyfile",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:accessibility:browser": "node scripts/smoke-accessibility.mjs"
  },
  "engines": {
    "node": ">=16"
  },
  "optionalDependencies": {
    "terser": "^5.48.0"
  },
  "devDependencies": {
    "@fortemi/core": "2026.6.8",
    "jest": "^30.4.2"
  }
}
