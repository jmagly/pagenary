{
  auto_https off

  servers :5175 {
    protocols h1 h2c
  }
}

(blog_data_headers) {
  @blog_data path */index.json */feed.xml
  header @blog_data Access-Control-Allow-Origin "*"
  header @blog_data Cache-Control "public, max-age=300"
}

http://tenant-default.local:5175, http://localhost:5175 {
  root * dist/tenant-default
  import blog_data_headers
  encode gzip zstd
  try_files {path} {path}/ index.html
  file_server
}

