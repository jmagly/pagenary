{
  "name": "pagenary",
  "private": true,
  "description": "Pagenary multi-tenant documentation platform monorepo",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "js-yaml": "3.15.0",
    "postcss": "8.5.23"
  },
  "scripts": {
    "bootstrap": "npm install --workspaces",
    "publisher:build": "npm run build --workspace @pagenary/publisher",
    "publisher:build:tenants": "npm run build:tenants --workspace @pagenary/publisher",
    "publisher:build:incremental": "npm run build:incremental --workspace @pagenary/publisher",
    "publisher:build:diff": "npm run build:diff --workspace @pagenary/publisher",
    "publisher:tenants:list": "npm run tenants:list --workspace @pagenary/publisher",
    "publisher:tenants:diff": "npm run tenants:diff --workspace @pagenary/publisher",
    "publisher:serve": "npm run serve --workspace @pagenary/publisher",
    "publisher:test": "npm run test --workspace @pagenary/publisher",
    "publisher:clean": "npm run clean --workspace @pagenary/publisher",
    "test": "npm run test:publisher && npm run test:react && npm run test:extension && npm run test:tooling",
    "test:publisher": "npm run test --workspace @pagenary/publisher -- --maxWorkers=2",
    "test:react": "npm run test --workspace @pagenary/react",
    "test:extension": "npm run test --workspace @pagenary/vscode-extension",
    "test:tooling": "node --test scripts/testing/*.test.mjs",
    "test:checks": "npm run check --workspace @pagenary/publisher",
    "test:browser": "SMOKE_REQUIRE=1 npm run test:browser --workspace @pagenary/publisher",
    "test:conformance": "aiwg test-conformance assess",
    "test:inventory": "aiwg test-conformance inventory",
    "test:setup": "node scripts/testing/setup-browser.mjs"
  }
}
