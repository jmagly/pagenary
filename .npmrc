# Pagenary .npmrc — supply-chain hardening (modeled on roctinam/aiwg)
#
# Committed to the repo; applies to every `npm install` / `npm ci` run with
# this directory (or an ancestor) as CWD — CI and dev machines alike.
#
# REQUIREMENT: npm 11.5+ for `min-release-age`. Node 20.x base images ship
# npm 10.x, so the publish workflow installs npm@^11.5 before `npm ci`.
# `npm ci` against a committed lockfile does not re-resolve, so this gate is
# effectively a no-op for locked installs and only bites on `npm install`.

# --- Release-age gate ---------------------------------------------------
# Refuse to install any dependency version published less than 7 days ago.
# Bounds the window for brand-new-malicious-publish (Mini Shai-Hulud) attacks.
min-release-age=7

# --- Scope routing ------------------------------------------------------
# @pagenary scoped packages resolve from the Gitea npm registry under the
# `pagenary` org. For SCOPED packages npm uses this @scope:registry over any
# --registry flag, so @pagenary/publisher publishes here. Workspace packages
# still resolve locally; this also routes any future external @pagenary dep.
@pagenary:registry=https://git.integrolabs.net/api/packages/pagenary/npm/
