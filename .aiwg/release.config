# Pagenary release configuration — consumed by the AIWG `flow-release` skill.
#
# CalVer (YYYY.M.PATCH, no leading zeros — see .claude/rules/versioning.md).
# The version of record is apps/publisher/package.json; the Gitea release
# workflow (.gitea/workflows/release.yml) verifies the pushed tag matches it.
#
# Usage:  invoke the `flow-release` skill, e.g. "release v2026.6.1"
#         or walk these gates manually per docs/ ../RELEASING.md.
version: 1

project:
  name: "@pagenary/publisher"
  display_name: Pagenary
  repo_url: https://git.integrolabs.net/roctinam/pagenary
  npm_package: "@pagenary/publisher"

version_policy:
  format: calver
  pattern: "YYYY.M.PATCH"          # display hint; the `versioning` rule enforces
  tag_prefix: v
  # The single source of truth for the version. Bump this file, then tag to match.
  version_source: apps/publisher/package.json
  channels:
    stable:
      tag_format: "v{YYYY}.{M}.{PATCH}"
      require_changelog: true
      require_announcement: false   # Pagenary ships changelog-only releases.
      require_uat: false

policy:
  no_ai_attribution: true           # .claude/rules/no-attribution.md (CRITICAL)
  ci_green_before_done: true        # never finalize on a red CI run
  preserve_pre_release_announcements: false
  thank_external_reporters: true

gates:
  # 1. Local quality gate — must be green before anything is committed.
  - name: local-quality
    hard_stop: true
    steps:
      - id: lint-content
        run: npm run lint:content --workspace @pagenary/publisher
      - id: unit-tests
        run: npm run test --workspace @pagenary/publisher
      - id: build-default
        run: npm run build --workspace @pagenary/publisher          # root dist/ (feeds seo-smoke)
      - id: build-tenants
        run: npm run build:tenants --workspace @pagenary/publisher

  # 1b. SEO smoke — warn-only. NOTE (known pre-existing): the stylesheet check
  #     expects `./styles.css`, but the #22 deep-link fix uses root-absolute
  #     `/styles.css` for nested-route cold loads. This finding is present on
  #     HEAD and is unrelated to feature releases; resolve by reconciling the
  #     seo-smoke regex with the shell-URL policy (tracked separately).
  - name: seo-smoke
    hard_stop: false
    steps:
      - id: seo
        run: npm run check:seo --workspace @pagenary/publisher

  # 2. Code → docs reconciliation (API/ARCHITECTURE/README freshness).
  - name: doc-sync
    hard_stop: true
    invoke_skill: doc-sync
    args:
      direction: code-to-docs
      dry_run_first: true
      guidance: |
        Reconcile apps/publisher/docs/*.md and the READMEs with the shipped
        publisher code. Verify the search/build surface, npm badges, and the
        ARCHITECTURE build flow reflect the release contents.

  # 3. Changelog entry must exist for the target version (stable only).
  - name: changelog
    hard_stop: true
    required_for_channels: [stable]
    artifacts:
      - path: CHANGELOG.md
        section_pattern: '## [{version}]'

  # 4. README freshness — surfaced for review, warn-only.
  - name: readme-freshness
    hard_stop: false
    review_diff:
      path: README.md
      since_tag: latest-stable
      prompt: 'Has the README (root + apps/publisher) been reviewed for this release?'

  # 5. Version sync — the tag will fail CI if these disagree, so assert early.
  - name: version-sync
    hard_stop: true
    steps:
      - id: assert-package-version
        run: >-
          node -e "const v=require('./apps/publisher/package.json').version;
          if(v!=='{version}'){console.error('apps/publisher/package.json is '+v+', expected {version}');process.exit(1)}"

  # 6. Release commit — version bump + changelog land on main (delivery: direct).
  #    Stage deliberately; do NOT sweep unrelated working-tree changes.
  - name: release-commit
    hard_stop: true
    steps:
      - id: commit
        run: git commit -m "release: v{version}"
        # The committer stages the release files before this gate runs.

  # 7. Signed tag + push. Tags MUST be signed with the RELEASE key
  #    (719AB63879E84CE8 — AIWG Release Signing <release@aiwg.io>), NOT the
  #    default commit key (0117DAAA677A5BF2). user.signingkey defaults to the
  #    commit key, so a bare `git tag -s` signs with the wrong key — always pass
  #    `-u 719AB63879E84CE8` (long id). Push ORIGIN ONLY; release.yml mirrors the
  #    tag to GitHub. The tag push triggers release.yml + npm-publish.yml +
  #    docsite-deploy.yml. See docs/contributing/releasing.md.
  - name: tag-and-push
    hard_stop: true
    actions:
      - signed_tag: "git tag -s -u 719AB63879E84CE8 {tag} -m '{tag}'"
      - push_main: "git push origin main"
      - push_tag: "git push origin {tag}"

  # 8. Post-release housekeeping — warn-only.
  - name: post-release
    hard_stop: false
    actions:
      - verify_publication: gitea          # confirm Gitea release + npm publish
      - reset_unreleased_changelog: true   # restore an empty '## [Unreleased]'
      - close_imported_issues_with_thanks: true
